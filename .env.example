# REPLACE YOUR_LOCAL_IP WITH YOUR OWN IP
# RUN 'ipconfig getifaddr en0' TO GET YOUR OWN IP
EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:3000

# Google OAuth client used only to read free/busy time.
# Enable the Google Calendar API, then create an iOS OAuth client
# whose bundle ID is com.anev.umdiningtracker.
# The iOS redirect is the reversed client ID:
# com.googleusercontent.apps.<client-prefix>:/oauth2redirect
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=30223160543-sd52hkcldfageqvte8f1e2suiglkjjdi.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Used when a platform-specific client ID above is empty.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=